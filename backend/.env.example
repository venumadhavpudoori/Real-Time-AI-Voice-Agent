# Database Configuration
# Default to PostgreSQL, or fallback to SQLite for local standalone run
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/restaurant_db
# SQLite fallback example: sqlite+aiosqlite:///./restaurant.db

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Optional: LLM Provider for Dynamic Responses (Agent has built-in rule/intent engine if empty)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Safety Guardrail Thresholds
ENABLE_SAFETY_GUARDRAILS=true
STRICT_ALLERGY_MODE=true
MAX_PARTY_SIZE=12
RESERVATION_WINDOW_DAYS=30

